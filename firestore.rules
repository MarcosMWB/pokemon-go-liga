rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ===================== HELPERS ===================== */
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // SUPERUSER: requer doc em superusers/{uid} (id do doc = UID)
    function isSuper() {
      return isSignedIn() &&
             exists(/databases/$(database)/documents/superusers/$(request.auth.uid));
    }

    // participante de match de trocas
    function isMatchParticipant(matchId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/trocas_matches/$(matchId)).data.users;
    }

    // participante de DESAFIO (1×1)
    function isDesafioParticipant(desafioId) {
      let d = get(/databases/$(database)/documents/desafios_ginasio/$(desafioId));
      return isSignedIn() &&
        (d.data.lider_uid == request.auth.uid || d.data.desafiante_uid == request.auth.uid);
    }

    // usuário é líder do ginásio?
    function isGymLeader(ginasioId) {
      let g = get(/databases/$(database)/documents/ginasios/$(ginasioId));
      return isSignedIn() && g.data.lider_uid == request.auth.uid;
    }

    // inteiro não-decrescente
    function nonDecreasingInt(oldVal, newVal) {
      let oldInt = oldVal is int ? oldVal : 0;
      let newInt = newVal is int ? newVal : 0;
      return newInt >= oldInt;
    }
    
    function blockDocId(ginasioId, desafianteUid) {
      return ginasioId + "__" + desafianteUid;
    }

    function cooldownOk(ginasioId, desafianteUid) {
      let p = /databases/$(database)/documents/bloqueios_ginasio/$(blockDocId(ginasioId, desafianteUid));
      return !exists(p) ||
        (
          get(p).data.lockedSeasonId != request.resource.data.temporada_id &&
          (!(get(p).data.blockedUntil is timestamp) ||
            get(p).data.blockedUntil <= request.time)
        );
    }

    function gymLeaderUid(ginasioId) {
      let p = /databases/$(database)/documents/ginasios/$(ginasioId);
      return exists(p) ? get(p).data.lider_uid : null;
    }

    function activeSeason(temporadaId) {
      let p = /databases/$(database)/documents/temporadas/$(temporadaId);
      return temporadaId is string && exists(p) && get(p).data.ativa == true;
    }

    /* ================ CONTAS / CADASTROS BÁSICOS ================ */

    match /superusers/{id} {
      allow read: if isOwner(id) || isSuper();
      allow create, update, delete: if isSuper();
    }

    // Dados privados da conta (inclui e-mail).
    match /usuarios_private/{uid} {
      allow read: if isOwner(uid) || isSuper();
      allow create: if isOwner(uid) || isSuper();

      // dono pode atualizar, mas sem elevar privilégios/campos sensíveis
      allow update: if isSuper() ||
        (
          isOwner(uid) &&
          (!('roles' in request.resource.data) || request.resource.data.roles == resource.data.roles) &&
          (!('verificado' in request.resource.data) || request.resource.data.verificado == resource.data.verificado) &&
          (!('isSuper' in request.resource.data) || request.resource.data.isSuper == resource.data.isSuper)
        );

      allow delete: if isSuper();
    }

    // Caixa de entrada escrita pelo Admin SDK; cada usuário só vê e marca os próprios avisos.
    match /notificacoes/{uid}/itens/{itemId} {
      allow read: if isOwner(uid);
      allow create, delete: if false;
      allow update: if isOwner(uid) &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['lida']) &&
        request.resource.data.lida is bool;
    }

    // PERFIL PRINCIPAL
    match /usuarios/{uid} {
      allow read: if true;

      // criar: próprio usuário ou super
      // O e-mail deve existir somente em usuarios_private/{uid}.
      allow create: if (isOwner(uid) || isSuper()) && !('email' in request.resource.data);

      // dono pode atualizar, com travas em campos sensíveis
      allow update: if !('email' in request.resource.data) && (isSuper() ||
        (
          isOwner(uid) &&
          (!('pontosPresenca' in request.resource.data) ||
            request.resource.data.pontosPresenca == resource.data.pontosPresenca) &&
          (!('pp_consumidos' in request.resource.data) ||
            nonDecreasingInt(resource.data.pp_consumidos, request.resource.data.pp_consumidos)) &&
          (!('verificado' in request.resource.data) ||
            request.resource.data.verificado == resource.data.verificado)
        ));
      // allow delete: if isSuper();
    }

    match /consumoPP/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    match /ligas/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    match /temporadas/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    /* ===================== GINÁSIOS ===================== */
    match /ginasios/{id} {
      allow read: if true;
      allow create, delete: if isSuper();
      allow update: if isSuper() || isGymLeader(id);
    }

    /* ========== RENÚNCIAS DE LIDERANÇA ========== */
    match /renuncias_ginasio/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.lider_uid == request.auth.uid;
      allow update, delete: if isSuper();
    }

    /* ========== DISPUTAS DE GINÁSIO (formato “evento/tabela”) ========== */
    match /disputas_ginasio/{id} {
      allow read: if isSignedIn();
      allow create: if isSuper() || (
        isSignedIn()
        && request.resource.data.origem == 'renuncia'
        && request.resource.data.status == 'inscricoes'
        && request.resource.data.ginasio_id is string
        && gymLeaderUid(request.resource.data.ginasio_id) == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ginasio_id','status','tipo_original','lider_anterior_uid',
          'temporada_id','temporada_nome','liga','origem','createdAt'
        ])
      );
      allow update, delete: if isSuper();
    }

    // coleção LEGADA de participantes de disputa (algumas telas antigas usam)
    match /disputas_ginasio_participantes/{id} {
      allow read: if isSignedIn();
      allow create: if (isSignedIn() && request.resource.data.usuario_uid == request.auth.uid) || isSuper();
      allow update: if isSignedIn() &&
        (resource.data.usuario_uid == request.auth.uid || isSuper());
      allow delete: if isSuper();
    }

    match /disputas_ginasio_resultados/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.declarado_por == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.declarado_por == request.auth.uid || isSuper());
      allow delete: if isSuper();
    }

    /* ========== DESAFIOS (1×1) + CHAT (subcoleção) ========== */
    match /desafios_ginasio/{id} {
      allow read: if true;

      allow create: if isSignedIn()
        && request.resource.data.desafiante_uid == request.auth.uid
        && request.resource.data.lider_uid == gymLeaderUid(request.resource.data.ginasio_id)
        && cooldownOk(request.resource.data.ginasio_id, request.auth.uid)
        && request.resource.data.status == 'pendente'
        && request.resource.data.temporada_id is string
        && activeSeason(request.resource.data.temporada_id)
        && (!('resultado_lider' in request.resource.data) || request.resource.data.resultado_lider == null)
        && (!('resultado_desafiante' in request.resource.data) || request.resource.data.resultado_desafiante == null)
        && (!('vencedor' in request.resource.data))
        && (!('vencedor_uid' in request.resource.data))
        && (!('fechadoEm' in request.resource.data))
        && (!('disputa_id' in request.resource.data) || request.resource.data.disputa_id == null)
        && request.resource.data.keys().hasOnly([
          'ginasio_id','liga','lider_uid','desafiante_uid','status',
          'resultado_lider','resultado_desafiante','createdAt','disputa_id',
          'temporada_id','temporada_nome'
        ]);

      function changedKeys() {
        return request.resource.data.diff(resource.data).changedKeys();
      }

      function isParticipant() {
        return isSignedIn() && (
          request.auth.uid == resource.data.lider_uid ||
          request.auth.uid == resource.data.desafiante_uid
        );
      }

      // permitir adicionar fechadoEm:null sem fechar (opcional)
      function addingFechadoEmNullOnly() {
        return changedKeys().hasAny(['fechadoEm']) &&
               request.resource.data.fechadoEm == null &&
               !(resource.data.keys().hasAny(['fechadoEm']));
      }

      // LÍDER só pode setar o próprio resultado, e apenas uma vez
      function canSetResultadoLider() {
        return isSignedIn()
          && request.auth.uid == resource.data.lider_uid
          && !(resource.data.status in ['concluido','conflito'])
          && (!resource.data.keys().hasAny(['resultado_lider']) || resource.data.resultado_lider == null)
          && (request.resource.data.resultado_lider in ['lider','desafiante'])
          && !changedKeys().hasAny(['resultado_desafiante'])
          && !changedKeys().hasAny(['vencedor','vencedor_uid','status','lider_uid','desafiante_uid','ginasio_id','createdAt'])
          && (!changedKeys().hasAny(['fechadoEm']) || addingFechadoEmNullOnly());
      }

      // DESAFIANTE só pode setar o próprio resultado, e apenas uma vez
      function canSetResultadoDesafiante() {
        return isSignedIn()
          && request.auth.uid == resource.data.desafiante_uid
          && !(resource.data.status in ['concluido','conflito'])
          && (!resource.data.keys().hasAny(['resultado_desafiante']) || resource.data.resultado_desafiante == null)
          && (request.resource.data.resultado_desafiante in ['lider','desafiante'])
          && !changedKeys().hasAny(['resultado_lider'])
          && !changedKeys().hasAny(['vencedor','vencedor_uid','status','lider_uid','desafiante_uid','ginasio_id','createdAt'])
          && (!changedKeys().hasAny(['fechadoEm']) || addingFechadoEmNullOnly());
      }

      // Fechamento CONCORDANTE (resultados já iguais no estado atual)
      function resultadosConcordantes() {
        return (resource.data.resultado_lider in ['lider','desafiante']) &&
               (resource.data.resultado_desafiante in ['lider','desafiante']) &&
               (resource.data.resultado_lider == resource.data.resultado_desafiante);
      }

      function vencedorUidEsperado() {
        return resource.data.resultado_lider == 'lider'
          ? resource.data.lider_uid
          : resource.data.desafiante_uid;
      }

      function canCloseConcordante() {
        return isParticipant()
          && resultadosConcordantes()
          && request.resource.data.status == 'concluido'
          && request.resource.data.vencedor == resource.data.resultado_lider
          && request.resource.data.vencedor_uid == vencedorUidEsperado()
          // no fechamento não pode mexer nos resultados
          && !changedKeys().hasAny(['resultado_lider','resultado_desafiante'])
          // apenas estes campos podem mudar ao fechar
          && changedKeys().hasOnly(['status','vencedor','vencedor_uid','fechadoEm','updatedAt','updatedBy','lastActivityAt']);
      }

      // Fechamento em CONFLITO (resultados diferentes no estado atual)
      function resultadosEmConflito() {
        return (resource.data.resultado_lider in ['lider','desafiante']) &&
               (resource.data.resultado_desafiante in ['lider','desafiante']) &&
               (resource.data.resultado_lider != resource.data.resultado_desafiante);
      }

      function canCloseConflito() {
        return isParticipant()
          && resultadosEmConflito()
          && request.resource.data.status == 'conflito'
          && !changedKeys().hasAny(['resultado_lider','resultado_desafiante','vencedor','vencedor_uid'])
          && changedKeys().hasOnly(['status','fechadoEm','updatedAt','updatedBy','lastActivityAt']);
      }

      allow update: if isSuper()
        || canSetResultadoLider()
        || canSetResultadoDesafiante()
        || canCloseConcordante()
        || canCloseConflito();

      allow delete: if isSuper();

      match /mensagens/{msgId} {
        allow read: if isDesafioParticipant(id) || isSuper();
        allow create: if isDesafioParticipant(id) && request.resource.data.from == request.auth.uid;
        allow delete: if isDesafioParticipant(id) || isSuper();
        allow update: if false;
      }
    }

    /* ====== HISTÓRICO / INSÍGNIAS / BLOQUEIOS / ALERTAS ====== */
    match /ginasios_liderancas/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    match /insignias/{id} {
      allow read: if true;
      // As insígnias são concedidas pela função após validar desafio concluído.
      allow create: if isSuper();
      allow update, delete: if isSuper();
    }

   match /bloqueios_ginasio/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuper();
    }

    match /alertas_conflito/{id} {
      allow read: if isSignedIn();
      allow create: if isSuper();
      allow update, delete: if isSuper();
    }

    /* ===================== ELITE 4 / CAMPEONATOS ===================== */
    match /elite4/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    match /elite4_mandatos/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    /* ========== GREAT PLATEAU / LIGA RO ========== */
    match /campeonatos_liga_ro/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
      match /participantes/{uid} {
        allow read: if true;
        allow create, update, delete: if isSuper();
      }
      match /rodadas/{roundId} {
        allow read: if true;
        allow create, update, delete: if isSuper();
        match /partidas/{matchId} {
          function isMatchPlayer() {
            return isSignedIn() && request.auth.uid in [resource.data.uid_a, resource.data.uid_b];
          }
          allow read: if true;
          allow create, delete: if isSuper();
          allow update: if isSuper() || (isMatchPlayer() &&
            request.resource.data.diff(resource.data).changedKeys().hasOnly([
              request.auth.uid == resource.data.uid_a ? 'report_a' : 'report_b'
            ]) &&
            (request.resource.data.report_a == null || request.resource.data.report_a in [resource.data.uid_a, resource.data.uid_b, 'empate']) &&
            (request.resource.data.report_b == null || request.resource.data.report_b in [resource.data.uid_a, resource.data.uid_b, 'empate']));
          match /mensagens/{msgId} {
            function isMatchPlayerByPath() {
              let m = get(/databases/$(database)/documents/campeonatos_liga_ro/$(id)/rodadas/$(roundId)/partidas/$(matchId));
              return isSignedIn() && request.auth.uid in [m.data.uid_a, m.data.uid_b];
            }
            allow read: if isMatchPlayerByPath() || isSuper();
            allow create: if isMatchPlayerByPath() && request.resource.data.from == request.auth.uid
              && request.resource.data.text is string && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 1000;
            allow update, delete: if isSuper();
          }
        }
      }
    }

    match /desafios_campeoes/{id} {
      function ownsGreatPlateauTrophy() {
        let badgeId = 'santo_antonio__' + request.resource.data.badge_tournament_id + '__' + request.auth.uid;
        let badge = get(/databases/$(database)/documents/insignias/$(badgeId));
        return badge.data.usuario_uid == request.auth.uid && badge.data.tipo == 'trofeu_great_plateau';
      }
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.challenger_uid == request.auth.uid
        && request.resource.data.status == 'solicitado'
        && request.resource.data.badge_tournament_id is string
        && request.resource.data.challenger_name is string
        && request.resource.data.liga is string
        && request.resource.data.stage == 0
        && request.resource.data.keys().hasOnly(['challenger_uid','challenger_name','badge_tournament_id','liga','status','stage','createdAt'])
        && ownsGreatPlateauTrophy();
      allow update, delete: if isSuper() || (isSignedIn() && resource.data.status == 'em_andamento'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reports'])
        && (
          (request.auth.uid == resource.data.challenger_uid
            && request.resource.data.reports.diff(resource.data.reports).changedKeys().hasOnly(['challenger'])
            && request.resource.data.reports.challenger in [resource.data.challenger_uid, resource.data.stage == 4 ? resource.data.champion.uid : resource.data.elites[resource.data.stage].uid])
          ||
          (request.auth.uid == (resource.data.stage == 4 ? resource.data.champion.uid : resource.data.elites[resource.data.stage].uid)
            && request.resource.data.reports.diff(resource.data.reports).changedKeys().hasOnly(['defender'])
            && request.resource.data.reports.defender in [resource.data.challenger_uid, resource.data.stage == 4 ? resource.data.champion.uid : resource.data.elites[resource.data.stage].uid])
        ));
      match /mensagens/{msgId} {
        function isChallengeChatPlayer() {
          let c = get(/databases/$(database)/documents/desafios_campeoes/$(id));
          return isSignedIn() && c.data.status == 'em_andamento' &&
            (request.auth.uid == c.data.challenger_uid ||
             request.auth.uid == (c.data.stage == 4 ? c.data.champion.uid : c.data.elites[c.data.stage].uid));
        }
        allow read: if isSuper() || isChallengeChatPlayer();
        allow create: if isChallengeChatPlayer() && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if isSuper();
      }
    }
    match /regiao_campeao/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }
    match /hall_da_fama/{id} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

      // FALTAVA ISTO:
      match /participantes/{uid} {
        allow read: if isSignedIn();
        allow create, update, delete: if isSuper();
      }
      
    match /campeonatos_elite4/{id} {
      allow read: if isSignedIn();           // ou 'if true' se quiser totalmente público
      allow create, update, delete: if isSuper();
      
      match /participantes/{uid} {
        allow read: if isSignedIn();

        // só permite mudar esses campos
        function onlyIncPontos() {
          return request.resource.data.diff(resource.data)
                   .changedKeys().hasOnly(['pontos','from_desafio','updatedAt','updatedBy']);
        }

        // pontos não podem diminuir
        function nonDecreasingPontos() {
          let oldP = resource.data.pontos is int ? resource.data.pontos : 0;
          let newP = request.resource.data.pontos is int ? request.resource.data.pontos : 0;
          return newP >= oldP;
        }

        // impede repetir o mesmo desafio (idempotência)
        function newFromDesafio() {
          return ('from_desafio' in request.resource.data)
                 && request.resource.data.from_desafio is string
                 && (!('from_desafio' in resource.data) || resource.data.from_desafio != request.resource.data.from_desafio);
        }

        // valida o desafio que originou o ponto
        function validFromDesafio() {
          let d = get(/databases/$(database)/documents/desafios_ginasio/$(request.resource.data.from_desafio));
          return d.exists()
            && d.data.status == 'concluido'
            && d.data.vencedor == 'lider'
            && d.data.lider_uid == uid
            // quem dispara pode ser líder OU desafiante (último a confirmar)
            && (request.auth != null)
            && (request.auth.uid == d.data.lider_uid || request.auth.uid == d.data.desafiante_uid);
        }

        // o docId = uid do líder; atualização idempotente por desafio
        function validEnrollment() {
          let camp = get(/databases/$(database)/documents/campeonatos_elite4/$(id));
          let gym = get(/databases/$(database)/documents/ginasios/$(request.resource.data.ginasio_id));
          return camp.exists() && camp.data.status == 'aberto' && gym.exists()
            && gym.data.lider_uid == request.auth.uid
            && gym.data.liga == request.resource.data.liga
            && camp.data.liga == request.resource.data.liga;
        }

        allow create: if isSuper() || (isSignedIn() && request.auth.uid == uid
          && request.resource.data.usuario_uid == uid
          && request.resource.data.campeonato_id == id
          && request.resource.data.pontos == 0
          && request.resource.data.keys().hasOnly(['campeonato_id','usuario_uid','ginasio_id','liga','pontos','createdAt'])
          && validEnrollment());

        allow update: if isSuper() || (isSignedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).changedKeys().hasOnly(['ginasio_id','pontos'])
          && request.resource.data.pontos == 0
          && request.resource.data.usuario_uid == uid
          && request.resource.data.campeonato_id == id
          && validEnrollment());

        allow delete: if isSuper();
      }
    }

    match /campeonatos_elite4_resultados/{id} {
      allow read: if isSignedIn();
      allow create: if isSuper();
      allow update, delete: if false;
    }

    // Autoriza collectionGroup(participantes) apenas quando o filtro é do próprio usuário.
    match /{path=**}/participantes/{uid} {
      allow read: if isSignedIn() &&
        (resource.data.usuario_uid == request.auth.uid || isSuper());
    }

    // COLEÇÃO LEGADA (plana) ainda lida por telas antigas/migração
    match /campeonatos_elite4_participantes/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuper();
    }

    // Auditoria dos pontos administrativos da disputa da Elite 4.
    match /campeonatos_elite4_pontuacoes/{id} {
      allow read: if isSignedIn();
      allow create: if isSuper();
      allow update, delete: if false;
    }

    /* ===================== TROCAS / RTS ===================== */
    match /trocas_ofertas/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /trocas_swipes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.fromUserId == request.auth.uid
        && request.resource.data.fromUserId == resource.data.fromUserId;
      allow delete: if isSignedIn() && resource.data.fromUserId == request.auth.uid;
    }

    match /trocas_matches/{matchId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] != request.resource.data.users[1]
        && request.auth.uid in request.resource.data.users;
      allow update: if isMatchParticipant(matchId)
        && request.resource.data.users == resource.data.users
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'invalid','updatedAt','lastActivityAt'
        ]);

      match /mensagens/{msgId} {
        allow read, create, delete: if isMatchParticipant(matchId);
        allow update: if false;
      }
    }

    /* ===================== PONTOS DE PRESENÇA (PP) ===================== */
    match /pp_qr_sessions/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    match /pp_qr/{sessionId} {
      allow read: if true;
      allow create, update, delete: if isSuper();
    }

    match /pp_pontos/{uid} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuper();
    }

    match /pp_registros/{regId} {
      function qrSession() {
        return get(/databases/$(database)/documents/pp_qr_sessions/$(request.resource.data.sessionId));
      }

      allow create: if
        (
          isSignedIn() &&
          request.resource.data.tipo == "qr" &&
          request.resource.data.user_uid == request.auth.uid &&
          request.resource.data.sessionId is string &&
          regId == (request.resource.data.sessionId + "_" + request.auth.uid) &&
          !exists(/databases/$(database)/documents/pp_registros/$(regId)) &&
          qrSession().exists() &&
          qrSession().data.ativo == true &&
          request.resource.data.userLat is number &&
          request.resource.data.userLng is number &&
          request.resource.data.userLat >= qrSession().data.minLat &&
          request.resource.data.userLat <= qrSession().data.maxLat &&
          request.resource.data.userLng >= qrSession().data.minLng &&
          request.resource.data.userLng <= qrSession().data.maxLng
        )
        ||
        (
          isSuper() &&
          request.resource.data.tipo == "manual" &&
          request.resource.data.user_uid is string
        );

      allow read: if isSignedIn() &&
        (resource.data.user_uid == request.auth.uid || isSuper());

      allow update, delete: if false;
    }

    /* ============== PP – LOGS VISUAIS ============== */
    match /pp_logs/{logId} {
      allow read: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isSuper());
      allow create: if isSignedIn() && isSuper() &&
        request.resource.data.userId is string;
      allow update, delete: if false;
    }

    /* ===================== VARIABLES (global) ===================== */
    function validVariablesData() {
      return request.resource.data.keys().hasOnly(['tempo_inscricoes', 'tempo_batalhas']) &&
             (request.resource.data.tempo_inscricoes is int) &&
             (request.resource.data.tempo_batalhas is int) &&
             request.resource.data.tempo_inscricoes >= 0 &&
             request.resource.data.tempo_batalhas >= 0 &&
             request.resource.data.tempo_inscricoes <= 24 * 14 &&
             request.resource.data.tempo_batalhas <= 24 * 14;
    }

    match /variables/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSuper() &&
        docId == "global" &&
        validVariablesData();
      allow delete: if isSuper() && docId == "global";
    }

    /* ===================== JOBS (Cloud Functions) ===================== */
    match /jobs_disputas/{jobId} {
      allow read, create, update, delete: if isSuper();
    }

    /* ===================== OUTROS ===================== */
    match /participacoes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.usuario_id == request.auth.uid;
      allow update: if isSignedIn() && resource.data.usuario_id == request.auth.uid
        && request.resource.data.usuario_id == resource.data.usuario_id;
      allow delete: if isSignedIn() && resource.data.usuario_id == request.auth.uid;
    }

    match /pokemon/{id} {
      function ownsParticipation(participacaoId) {
        let participation = get(/databases/$(database)/documents/participacoes/$(participacaoId));
        return isSignedIn() && participation.data.usuario_id == request.auth.uid;
      }
      allow read: if isSignedIn();
      allow create: if request.resource.data.participacao_id is string
        && ownsParticipation(request.resource.data.participacao_id);
      allow update: if false;
      allow delete: if resource.data.participacao_id is string
        && ownsParticipation(resource.data.participacao_id);
    }

    // Coleção legada: não há cliente atual que dependa de escritas diretas.
    match /mensagens/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuper();
    }

    match /produtos_loja/{id} {
      allow read: if true;
      allow create, update: if isSuper();
    }
  }
}
